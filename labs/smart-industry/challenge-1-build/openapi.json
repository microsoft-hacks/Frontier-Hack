{
  "openapi": "3.0.3",
  "info": {
    "title": "API \u2014 Smart Industry",
    "description": "Retorna telemetria atual, par\u00e2metros operacionais, status, motivos e alertas das m\u00e1quinas da Unidade Industrial SP.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Substitua pela URL base da API confirmada pelo facilitador"
    }
  ],
  "paths": {
    "/plant/status": {
      "get": {
        "summary": "Obt\u00e9m o resumo da planta",
        "description": "Retorna o resumo de m\u00e1quinas por status (online, alert, offline), os IDs em alerta e offline e as unidades de cada campo.",
        "operationId": "get_plant_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantStatus"
                }
              }
            }
          }
        }
      }
    },
    "/machines": {
      "get": {
        "summary": "Lista as m\u00e1quinas",
        "description": "Retorna a telemetria, os par\u00e2metros, o status, os motivos e os alertas de todas as m\u00e1quinas. Use os filtros opcionais status e type para restringir o resultado.",
        "operationId": "list_machines",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/MachineStatus"
            },
            "description": "Filtra por status: online, alert ou offline."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Filtra por tipo: cnc, robot, conveyor, forklift, injector, press ou welder.",
              "title": "Type"
            },
            "description": "Filtra por tipo: cnc, robot, conveyor, forklift, injector, press ou welder."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/machines/{machine_id}": {
      "get": {
        "summary": "Obt\u00e9m uma m\u00e1quina",
        "description": "Use esta opera\u00e7\u00e3o sempre que um ID de m\u00e1quina como CNC-003 precisar ser analisado. Ela retorna telemetria, par\u00e2metros com limites, status, motivos e alertas.",
        "operationId": "get_machine",
        "parameters": [
          {
            "name": "machine_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "ID da m\u00e1quina (por exemplo CNC-003, ROB-003, CVY-003, INJ-002)",
              "title": "Machine Id"
            },
            "description": "ID da m\u00e1quina (por exemplo CNC-003, ROB-003, CVY-003, INJ-002)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Machine"
                }
              }
            }
          },
          "404": {
            "description": "M\u00e1quina n\u00e3o encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric",
            "description": "M\u00e9trica em alerta (temp ou vib). Ausente em perda de comunica\u00e7\u00e3o."
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "Tipo do alerta quando n\u00e3o \u00e9 de m\u00e9trica, por exemplo communication_lost."
          },
          "level": {
            "$ref": "#/components/schemas/AlertLevel",
            "description": "Severidade do alerta: warn, critical ou offline."
          },
          "value": {
            "type": "number",
            "title": "Value",
            "description": "Valor medido que violou o limite."
          },
          "limit": {
            "type": "number",
            "title": "Limit",
            "description": "Limite excedido."
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "description": "Unidade do valor e do limite."
          },
          "initialSimulatedSilenceMinutes": {
            "type": "number",
            "title": "Initialsimulatedsilenceminutes",
            "description": "Minutos simulados sem comunica\u00e7\u00e3o no cadastro inicial (perda de comunica\u00e7\u00e3o)."
          }
        },
        "type": "object",
        "required": [
          "level"
        ],
        "title": "Alert"
      },
      "AlertLevel": {
        "type": "string",
        "enum": [
          "warn",
          "critical",
          "offline"
        ],
        "title": "AlertLevel"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human-readable error message."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Machine": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "ID da m\u00e1quina, por exemplo CNC-003."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Tipo da m\u00e1quina: cnc, robot, conveyor, forklift, injector, press ou welder."
          },
          "typeLabel": {
            "type": "string",
            "title": "Typelabel"
          },
          "status": {
            "$ref": "#/components/schemas/MachineStatus",
            "description": "Status da m\u00e1quina: online, alert ou offline."
          },
          "statusLabel": {
            "type": "string",
            "title": "Statuslabel"
          },
          "commLost": {
            "type": "boolean",
            "title": "Commlost",
            "description": "Verdadeiro quando a comunica\u00e7\u00e3o com a m\u00e1quina foi perdida."
          },
          "telemetryQuality": {
            "type": "string",
            "title": "Telemetryquality",
            "description": "Qualidade da telemetria, por exemplo simulated_reference."
          },
          "telemetry": {
            "$ref": "#/components/schemas/Telemetry"
          },
          "params": {
            "$ref": "#/components/schemas/Params"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons",
            "description": "Motivos leg\u00edveis do status atual; vazio quando online."
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "type": "array",
            "title": "Alerts",
            "description": "Alertas estruturados; vazio quando online."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "typeLabel",
          "status",
          "statusLabel",
          "commLost",
          "telemetryQuality",
          "telemetry",
          "params",
          "reasons",
          "alerts"
        ],
        "title": "Machine"
      },
      "MachineList": {
        "properties": {
          "company": {
            "type": "string",
            "title": "Company"
          },
          "plant": {
            "type": "string",
            "title": "Plant"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "machines": {
            "items": {
              "$ref": "#/components/schemas/Machine"
            },
            "type": "array",
            "title": "Machines"
          }
        },
        "type": "object",
        "required": [
          "company",
          "plant",
          "timestamp",
          "count",
          "machines"
        ],
        "title": "MachineList"
      },
      "MachineStatus": {
        "type": "string",
        "enum": [
          "online",
          "alert",
          "offline"
        ],
        "title": "MachineStatus"
      },
      "Params": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "Modo de opera\u00e7\u00e3o: auto, paused ou off."
          },
          "modeLabel": {
            "type": "string",
            "title": "Modelabel",
            "description": "R\u00f3tulo leg\u00edvel do modo de opera\u00e7\u00e3o."
          },
          "speed": {
            "type": "number",
            "title": "Speed",
            "description": "Velocidade configurada em %."
          },
          "targetTemp": {
            "type": "number",
            "title": "Targettemp",
            "description": "Temperatura alvo em \u00b0C."
          },
          "tempLimit": {
            "type": "number",
            "title": "Templimit",
            "description": "Limite de temperatura em \u00b0C."
          },
          "vibLimit": {
            "type": "number",
            "title": "Viblimit",
            "description": "Limite de vibra\u00e7\u00e3o em mm/s."
          },
          "cycleTime": {
            "type": "number",
            "title": "Cycletime",
            "description": "Tempo de ciclo em segundos."
          }
        },
        "type": "object",
        "required": [
          "mode",
          "modeLabel",
          "speed",
          "targetTemp",
          "tempLimit",
          "vibLimit",
          "cycleTime"
        ],
        "title": "Params"
      },
      "PlantStatus": {
        "properties": {
          "company": {
            "type": "string",
            "title": "Company"
          },
          "plant": {
            "type": "string",
            "title": "Plant"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "units": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Units",
            "description": "Unidade de cada campo, por exemplo telemetry.temp: \u00b0C."
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          }
        },
        "type": "object",
        "required": [
          "company",
          "plant",
          "timestamp",
          "units",
          "summary"
        ],
        "title": "PlantStatus"
      },
      "Summary": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "online": {
            "type": "integer",
            "title": "Online"
          },
          "alert": {
            "type": "integer",
            "title": "Alert"
          },
          "offline": {
            "type": "integer",
            "title": "Offline"
          },
          "machinesWithCriticalTemperature": {
            "type": "integer",
            "title": "Machineswithcriticaltemperature"
          },
          "alertMachineIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alertmachineids"
          },
          "offlineMachineIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Offlinemachineids"
          }
        },
        "type": "object",
        "required": [
          "total",
          "online",
          "alert",
          "offline",
          "machinesWithCriticalTemperature",
          "alertMachineIds",
          "offlineMachineIds"
        ],
        "title": "Summary"
      },
      "Telemetry": {
        "properties": {
          "temp": {
            "type": "number",
            "title": "Temp",
            "description": "Temperatura atual em \u00b0C."
          },
          "vib": {
            "type": "number",
            "title": "Vib",
            "description": "Vibra\u00e7\u00e3o atual em mm/s."
          },
          "usage": {
            "type": "number",
            "title": "Usage",
            "description": "Taxa de utiliza\u00e7\u00e3o atual em %."
          }
        },
        "type": "object",
        "required": [
          "temp",
          "vib",
          "usage"
        ],
        "title": "Telemetry"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}